{"scopeName": "source.gdshader", "patterns": [{"include": "#comments"}, {"include": "#strings"}, {"include": "#numbers"}, {"include": "#keywords"}, {"match": "\\\\b[A-Za-z_][A-Za-z0-9_]*(?=\\\\s*\\\\()", "name": "entity.name.function"}, {"match": "\\\\b[A-Z][A-Za-z0-9_]*\\\\b", "name": "entity.name.type"}], "repository": {"comments": {"patterns": [{"match": "\\#.*$", "name": "comment.line"}]}, "strings": {"patterns": [{"begin": "\"", "end": "\"", "name": "string.quoted.double"}, {"begin": "'", "end": "'", "name": "string.quoted.single"}]}, "numbers": {"patterns": [{"match": "\\\\b(?:0x[0-9A-Fa-f]+|\\\\d+(?:\\\\.\\\\d+)?)\\\\b", "name": "constant.numeric"}]}, "keywords": {"patterns": [{"match": "\\\\b(?:shader_type|render_mode|uniform|varying|const|void|float|vec2|vec3|vec4|mat2|mat3|mat4|if|else|for|return)\\\\b", "name": "keyword.control"}]}}}