{"scopeName": "source.gdscript", "patterns": [{"include": "#comments"}, {"include": "#strings"}, {"include": "#numbers"}, {"include": "#keywords"}, {"match": "\\\\b[A-Za-z_][A-Za-z0-9_]*(?=\\\\s*\\\\()", "name": "entity.name.function"}, {"match": "\\\\b[A-Z][A-Za-z0-9_]*\\\\b", "name": "entity.name.type"}], "repository": {"comments": {"patterns": [{"match": "\\#.*$", "name": "comment.line"}]}, "strings": {"patterns": [{"begin": "\"", "end": "\"", "name": "string.quoted.double"}, {"begin": "'", "end": "'", "name": "string.quoted.single"}]}, "numbers": {"patterns": [{"match": "\\\\b(?:0x[0-9A-Fa-f]+|\\\\d+(?:\\\\.\\\\d+)?)\\\\b", "name": "constant.numeric"}]}, "keywords": {"patterns": [{"match": "\\\\b(?:extends|class_name|func|var|const|signal|enum|if|elif|else|for|while|match|when|return|break|continue|pass|await|async|static|tool|export|onready|preload|load|self|super|true|false|null)\\\\b", "name": "keyword.control"}]}}}